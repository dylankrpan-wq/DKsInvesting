# Streamlit Cloud reads secrets from this file (named secrets.toml, not .example).
# In Streamlit Community Cloud you don't create this file — you paste these values
# into the app's Settings → Secrets editor on the website.
# This .example file just documents what keys the app supports.
#
# Format is TOML — same key names as config/secrets.env.

# Optional API keys
NEWSAPI_KEY = ""
FINNHUB_KEY = ""
ALPHAVANTAGE_KEY = ""
ANTHROPIC_API_KEY = ""

# Discord push alerts
DISCORD_WEBHOOK_URL = ""

# Brokers (read-only, optional)
COINBASE_API_KEY_NAME = ""
COINBASE_PRIVATE_KEY = ""
ROBINHOOD_USERNAME = ""
ROBINHOOD_PASSWORD = ""
ROBINHOOD_MFA_CODE = ""
BLOFIN_API_KEY = ""
BLOFIN_API_SECRET = ""
BLOFIN_API_PASSPHRASE = ""
SCHWAB_APP_KEY = ""
SCHWAB_APP_SECRET = ""
SCHWAB_REFRESH_TOKEN = ""

# TradingView webhook secret (only relevant if you run the webhook receiver elsewhere)
DK_WEBHOOK_SECRET = ""
