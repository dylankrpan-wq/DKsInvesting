# Copy this file to secrets.env and fill in keys you have.
# All keys are OPTIONAL in Phase 1 — the app gracefully skips sources without keys.

NEWSAPI_KEY=
FINNHUB_KEY=
ALPHAVANTAGE_KEY=

# Optional: Discord webhook for push alerts
DISCORD_WEBHOOK_URL=

# Optional: Anthropic API key for richer thesis narratives
ANTHROPIC_API_KEY=

# --- Brokers (all read-only, all opt-in) ---

# Coinbase Advanced Trade — generate at https://www.coinbase.com/cloud/api/cdp
COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY=

# Robinhood (unofficial — username + password; ToS-grey)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_CODE=

# Blofin — generate at https://blofin.com (read-only scope)
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSPHRASE=

# Schwab — register dev app first at https://developer.schwab.com
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REFRESH_TOKEN=

# TradingView webhook receiver — shared secret for POSTs to /tv-alert
# Set this to any random string and include the same value in your TV webhook JSON.
DK_WEBHOOK_SECRET=
