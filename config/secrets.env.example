# Copy this file to secrets.env and fill in keys you have.
# All keys are OPTIONAL in Phase 1 — the app gracefully skips sources without keys.

NEWSAPI_KEY=       # newsapi.org (32-hex) OR newsapi.ai/Event Registry (UUID) — auto-detected
FINNHUB_KEY=       # free at finnhub.io — enables analyst consensus-shift alerts (ANALYST_ACTION)
ALPHAVANTAGE_KEY=

# --- Financial Modeling Prep (market movers/quotes) ---
# Free key: https://site.financialmodelingprep.com -> Dashboard -> API Keys
# NOTE: FMP's economic calendar is now PAID (free key 402/403). The free key still
# powers market movers (gainers/losers/most-active) + quotes.
FMP_API_KEY=

# --- FRED (free US economic data prints -> ECON_PRINT alerts) ---
# Instant free key: https://fred.stlouisfed.org/docs/api/api_key.html
# CPI / Core PCE / Nonfarm Payrolls / Unemployment / GDP / Jobless Claims etc.
# (actual vs previous — no consensus estimate exists on any free tier).
FRED_API_KEY=

# Optional: Discord webhook for push alerts
DISCORD_WEBHOOK_URL=

# Optional: Anthropic API key for richer thesis narratives
ANTHROPIC_API_KEY=

# --- Brokers (all read-only, all opt-in) ---

# Coinbase Advanced Trade — generate at https://www.coinbase.com/cloud/api/cdp
COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY=

# Robinhood (unofficial — username + password; ToS-grey)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_CODE=

# Blofin — generate at https://blofin.com (read-only scope)
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSPHRASE=

# Schwab — register dev app first at https://developer.schwab.com
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REFRESH_TOKEN=

# TradingView webhook receiver — shared secret for POSTs to /tv-alert
# Set this to any random string and include the same value in your TV webhook JSON.
DK_WEBHOOK_SECRET=

# Public base URL of the deployed app (Railway domain). Enables tap-through
# "full thesis" deep-links in Telegram pushes, e.g. https://dks....up.railway.app
DK_APP_URL=

# --- Phone alerts for live events ---

# Option BEST (free, instant, no carrier approval): Telegram.
# 1) In Telegram, message @BotFather -> /newbot -> copy the token.
# 2) Message your new bot once, then message @userinfobot to get your numeric ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Your phone in E.164 format, e.g. +13055551234 (for Twilio/email-gateway SMS)
SMS_TO_NUMBER=

# Option A (recommended, true SMS): Twilio. Get a free trial at twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Option B (free, carrier-dependent): email-to-SMS gateway.
# Set SMS_CARRIER to one of: verizon, att, tmobile, sprint, boost, cricket,
# uscellular, metropcs, googlefi  — plus SMTP creds (Gmail app password works).
SMS_CARRIER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
